PORT=5000

# ============================================================
# GOOGLE CLOUD CREDENTIALS
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Admin accounts (comma-separated). The FIRST one is the calendar owner.
ADMIN_EMAILS=meenupkc@gmail.com,mohankumarcts25@gmail.com

# Secret used to sign session JWTs
JWT_SECRET=change-this-to-a-long-random-secret-string

# Frontend URL (for OAuth redirect back after login)
FRONTEND_URL=http://localhost:3000

# ============================================================
# EMAIL OTP — SMTP (Gmail). App password required.
# Optional: SendGrid HTTPS API — leave SENDGRID_API_KEY blank to use SMTP.
# ============================================================
SENDGRID_API_KEY=
EMAIL_FROM=mohankumarcts25@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mohankumarcts25@gmail.com
SMTP_PASS=

# ============================================================
# SMS OTP — Twilio settings
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============================================================
# SUPABASE — database (https://app.supabase.com → Project → Settings → API)
# Use the SERVICE ROLE key on the backend for full read/write access.
# (Publishable/anon key is provided below; if you have the service_role
#  key, paste it into SUPABASE_SERVICE_KEY for unrestricted server access.)
# ============================================================
SUPABASE_URL=https://cleaytvupoddozkmokff.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ============================================================
# RAZORPAY — Test mode (https://dashboard.razorpay.com/app/keys)
# KEY_SECRET must NEVER be exposed to the frontend.
# ============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
